# PostgreSQL 16+; create the xuzhang database before starting the API.
NOVEL_DATABASE_URL=postgresql://localhost/xuzhang
NOVEL_DATABASE_SCHEMA=public
NOVEL_API_URL=http://127.0.0.1:8010
NOVEL_PUBLIC_URL=http://127.0.0.1:8010
NOVEL_PRODUCTION=false
NOVEL_REGISTRATION_ENABLED=true
# MCP clients only: create your personal token in the browser's connection settings.
# NOVEL_API_TOKEN=xz_mcp_...
# Production requires an HTTPS public URL. Exact hosts/origins are JSON arrays.
# NOVEL_ALLOWED_HOSTS=["novel.example.com"]
# NOVEL_ALLOWED_ORIGINS=["https://novel.example.com"]
# Original EPUB/TXT files stay on disk; project records and releases live in PostgreSQL.
# NOVEL_DATA_DIR=/absolute/path/to/xuzhang-data
